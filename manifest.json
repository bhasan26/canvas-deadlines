{
  "manifest_version": 3,
  "name": "Canvas Deadlines",
  "version": "1.1.0",
  "description": "Your Canvas assignments, organized by what is due next.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Canvas Deadlines"
  },
  "content_scripts": [
    {
      "matches": [
        "https://whitworth.instructure.com/*"
      ],
      "js": [
        "canvas-api.js",
        "sidebar.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
